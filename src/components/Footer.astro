---
import { Image } from "astro:assets";
import site from "../data/site.json";
import footerLogo from "../assets/brand/mbm-lockup-stacked-dark.png";
const year = new Date().getFullYear();
---
<footer class="footer footer-center bg-neutral text-neutral-content p-10">
  <aside>
    <Image src={footerLogo} alt={site.business.name} width={200} height={113} class="w-40 h-auto mx-auto" />
    <p class="text-neutral-content/70">{site.business.location}</p>
    <div class="flex flex-wrap gap-4 mt-2 justify-center">
      <a href={site.business.phoneHref} class="link link-hover">{site.business.phone}</a>
      <a href={`mailto:${site.business.email}`} class="link link-hover">Email</a>
      <a href={site.business.instagram} target="_blank" rel="noopener noreferrer" class="link link-hover">Instagram</a>
    </div>
    <nav class="mt-2 flex gap-4 text-sm text-neutral-content/60 justify-center">
      <a href="/privacy" class="link link-hover">Privacy</a>
      <a href="/terms" class="link link-hover">Terms</a>
    </nav>
    <div class="mt-4 flex flex-col items-center gap-1">
      <p class="text-xs uppercase tracking-wide text-neutral-content/50">Resources for players &amp; parents</p>
      <nav class="flex flex-wrap gap-x-4 gap-y-1 justify-center text-sm">
        <a href="https://www.mlb.com/pitch-smart" target="_blank" rel="noopener noreferrer" class="link link-hover text-neutral-content/70">Pitch Smart — youth arm care<span class="sr-only"> (opens in a new tab)</span></a>
        <a href="https://www.usabaseball.com" target="_blank" rel="noopener noreferrer" class="link link-hover text-neutral-content/70">USA Baseball<span class="sr-only"> (opens in a new tab)</span></a>
        <a href="https://www.littleleague.org" target="_blank" rel="noopener noreferrer" class="link link-hover text-neutral-content/70">Little League<span class="sr-only"> (opens in a new tab)</span></a>
      </nav>
    </div>
    <p class="mt-2 text-xs text-neutral-content/50">© {year} {site.business.name}. All rights reserved.</p>
    <p class="mt-1 text-xs text-neutral-content/50">Site by <a href="https://clayboicardi.com/studio/" class="link link-hover">Clayboicardi Studio</a></p>
  </aside>
</footer>
