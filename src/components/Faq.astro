---
import faq from "../data/faq.json";

interface FaqItem { q: string; a: string; }
const faqs = faq as FaqItem[];

// FAQPage structured data — same inline JSON-LD pattern as BaseLayout's
// LocalBusiness schema (search Google Rich Results once live).
// IMPORTANT: resolve every "[CONFIRM w/ Myles: ...]" note in faq.json BEFORE
// wiring this into index.astro — those bracketed notes would otherwise ship
// into both the visible answers and the schema.
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---
<section id="faq" class="py-20 px-4 bg-base-100">
  <div class="max-w-3xl mx-auto">
    <h2 class="text-3xl font-heading font-bold text-primary uppercase text-center">Frequently Asked Questions</h2>
    <p class="text-center mt-2 text-base-content/70">Everything parents ask before the first lesson.</p>
    <div class="mt-10 space-y-3">
      {faqs.map((f) => (
        <details class="collapse collapse-arrow bg-base-200">
          <summary class="collapse-title text-lg font-semibold">{f.q}</summary>
          <div class="collapse-content"><p class="text-base-content/80">{f.a}</p></div>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
</section>
