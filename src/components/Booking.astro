---
import site from "../data/site.json";
import SectionHeading from "./ui/SectionHeading.astro";
const { calcom, tallyInquiryEmbed } = site.booking;
const hasCalcom = Boolean(calcom.base);
const hasTally = Boolean(tallyInquiryEmbed);
---
<section id="book" class="py-20 px-4 bg-paper">
  <div class="max-w-4xl mx-auto text-center">
    <SectionHeading eyebrow="Get on the Schedule" title="Book a Session" />
    <p class="mt-4 text-base-content/70">Pick a time that works for you — or ask about a multi-session package or the Elite program.</p>

    <div class="mt-8">
      {hasCalcom ? (
        <iframe title="Book a session" src={`https://cal.com/${calcom.base}`} sandbox="allow-scripts allow-forms allow-same-origin allow-popups" referrerpolicy="strict-origin-when-cross-origin" class="w-full rounded-box border border-base-300" style="height:700px" loading="lazy"></iframe>
      ) : (
        <div class="card bg-base-100 border border-base-300 p-8">
          <p class="text-base-content/70">Online scheduling is being set up. To book your free first lesson now, call or text
            <a class="link link-primary font-semibold" href={site.business.phoneHref}>{site.business.phone}</a>.</p>
        </div>
      )}
    </div>

    <div id="program-inquiry" class="mt-12">
      <h3 class="text-2xl font-heading text-primary">Package &amp; Program Inquiry</h3>
      <p class="mt-2 text-base-content/70">Interested in the 10-Session Package or the Elite Season Program? Send a quick inquiry and Coach Myles will follow up with scheduling, pricing, and a plan.</p>
      {hasTally ? (
        <iframe title="Package and program inquiry" src={`https://tally.so/embed/${tallyInquiryEmbed}?hideTitle=1`} sandbox="allow-scripts allow-forms allow-same-origin allow-popups" referrerpolicy="strict-origin-when-cross-origin" class="w-full rounded-box border border-base-300 mt-4" style="height:1350px" loading="lazy"></iframe>
      ) : (
        <p class="mt-4 text-base-content/70">For the 10-Session Package or Elite Season Program, call/text
          <a class="link link-primary font-semibold" href={site.business.phoneHref}>{site.business.phone}</a> or email
          <a class="link link-primary font-semibold" href={`mailto:${site.business.email}`}>{site.business.email}</a>.</p>
      )}
    </div>
  </div>
</section>
