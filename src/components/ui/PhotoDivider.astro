---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
// A slim, full-bleed duotone (navy + marigold) texture strip between sections.
// Pass `alt` for a real, described photo (exposed to assistive tech + image
// search); leave it empty for a purely decorative strip (then it's aria-hidden).
// Always lazy-loaded — these sit below the fold.
interface Props {
  src: ImageMetadata;
  alt?: string;
  widths?: number[];
  class?: string;
}
const { src, alt = "", widths = [640, 960, 1264], class: className } = Astro.props;
---
<div class:list={["duotone w-full h-24 sm:h-32", className]} aria-hidden={alt ? undefined : true}>
  <Image src={src} alt={alt} widths={widths} sizes="100vw" format="webp" loading="lazy" quality={60} />
</div>
