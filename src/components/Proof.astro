---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import site from "../data/site.json";
import testimonials from "../data/testimonials.json";
import SectionHeading from "./ui/SectionHeading.astro";

interface Testimonial { quote: string; author: string; }

// Filename -> descriptive alt for the gallery photos. The numeric prefixes set
// the curated display order (the grid renders in filename sort order). Keep in
// sync when the photos change; an unmapped file falls back to alt="" (decorative).
const altTexts: Record<string, string> = {
  "01-mound-meeting.jpg": "Coach Myles holds a mound meeting with five young baseball players in Long Beach",
  "02-fielding-practice.jpg": "Baseball coach points out fielding positioning to two teen players during practice",
  "03-game-in-progress.jpg": "Youth baseball game in progress at a Long Beach Little League field",
  "04-batter-at-plate.jpg": "Young batter at the plate with coach watching from the dugout during a game",
  "05-base-runner.jpg": "Coach guides a young player on base during an Orange County youth baseball game",
};

const galleryMods = import.meta.glob<{ default: ImageMetadata }>("../assets/photos/gallery/*.{jpg,jpeg,png}", { eager: true });
const gallery = Object.entries(galleryMods)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => ({ src: mod.default, alt: altTexts[path.split("/").pop() ?? ""] ?? "" }));

const testimonialList = testimonials as Testimonial[];
---
<section id="gallery" class="py-20 px-4 bg-base-100">
  <div class="max-w-6xl mx-auto">
    <SectionHeading eyebrow="From the Dugout" title="On the Field" />
    <div class="mt-8 grid grid-cols-2 md:grid-cols-3 gap-3">
      {gallery.map((img) => <Image src={img.src} alt={img.alt} width={420} quality={70} class="rounded-box w-full h-48 object-cover" />)}
    </div>

    {testimonialList.length > 0 && (
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {testimonialList.map((t) => (
          <blockquote class="card bg-base-200 p-6">
            <p class="italic">&ldquo;{t.quote}&rdquo;</p>
            <footer class="mt-3 text-sm font-semibold text-primary">— {t.author}</footer>
          </blockquote>
        ))}
      </div>
    )}

    <div class="text-center mt-10">
      <a href={site.business.instagram} target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-primary">Follow {site.business.instagramHandle}</a>
    </div>
  </div>
</section>
