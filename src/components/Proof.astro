---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import site from "../data/site.json";
import testimonials from "../data/testimonials.json";

interface Testimonial { quote: string; author: string; rating?: number; }

// Filename -> descriptive alt for the gallery photos. Keep in sync when the
// photos change; an unmapped file falls back to alt="" (treated decorative).
const altTexts: Record<string, string> = {
  "1f9aaa02-d568-4dd1-8f93-db47c27bb82a.jpg": "Coach Myles holds a mound meeting with five young baseball players in Long Beach",
  "c109f697-fd63-4ee9-84fc-5884a7790fe1.jpg": "Baseball coach points out fielding positioning to two teen players during practice",
  "c2eaf26d-9bc6-4bec-87d4-a7a5585877e7.jpg": "Youth baseball game in progress at a Long Beach Little League field",
  "c3c279bc-6e5c-4957-b653-81eff8ac225c.jpg": "Young batter at the plate with coach watching from the dugout during a game",
  "df3b7201-1170-41fb-bb45-6440842f6fe5.jpg": "Coach guides a young player on base during an Orange County youth baseball game",
};

const galleryMods = import.meta.glob<{ default: ImageMetadata }>("../assets/photos/gallery/*.{jpg,jpeg,png}", { eager: true });
const gallery = Object.entries(galleryMods)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => ({ src: mod.default, alt: altTexts[path.split("/").pop() ?? ""] ?? "" }));

const testimonialList = testimonials as Testimonial[];
const businessId = new URL("/#localbusiness", Astro.site).href;
const ratings = testimonialList
  .map((testimonial) => testimonial.rating)
  .filter((rating): rating is number => typeof rating === "number" && Number.isFinite(rating));
const reviewSchema =
  testimonialList.length > 0
    ? {
        "@context": "https://schema.org",
        "@id": businessId,
        review: testimonialList.map((testimonial) => ({
          "@type": "Review",
          author: { "@type": "Person", name: testimonial.author },
          reviewBody: testimonial.quote,
          itemReviewed: { "@id": businessId },
          ...(typeof testimonial.rating === "number" && Number.isFinite(testimonial.rating)
            ? { reviewRating: { "@type": "Rating", ratingValue: testimonial.rating } }
            : {}),
        })),
        ...(ratings.length > 0
          ? {
              aggregateRating: {
                "@type": "AggregateRating",
                ratingValue: ratings.reduce((sum, rating) => sum + rating, 0) / ratings.length,
                reviewCount: ratings.length,
              },
            }
          : {}),
      }
    : undefined;
---
{reviewSchema && <script type="application/ld+json" is:inline set:html={JSON.stringify(reviewSchema)} />}
<section id="gallery" class="py-20 px-4 bg-base-100">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-3xl font-heading font-bold text-primary uppercase text-center">On the Field</h2>
    <div class="mt-8 grid grid-cols-2 md:grid-cols-3 gap-3">
      {gallery.map((img) => <Image src={img.src} alt={img.alt} width={420} quality={70} class="rounded-box w-full h-48 object-cover" />)}
    </div>

    {testimonialList.length > 0 && (
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {testimonialList.map((t) => (
          <blockquote class="card bg-base-200 p-6">
            <p class="italic">&ldquo;{t.quote}&rdquo;</p>
            <footer class="mt-3 text-sm font-semibold text-primary">— {t.author}</footer>
          </blockquote>
        ))}
      </div>
    )}

    <div class="text-center mt-10">
      <a href={site.business.instagram} target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-primary">Follow {site.business.instagramHandle}</a>
    </div>
  </div>
</section>
