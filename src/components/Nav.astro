---
import { Image } from "astro:assets";
import site from "../data/site.json";
import navLogo from "../assets/brand/mbm-lockup-horizontal.png";
import navMonogram from "../assets/brand/mbm-monogram.png";
---
<header class="navbar bg-base-100/90 backdrop-blur sticky top-0 z-50 border-b border-base-300">
  <div class="navbar-start">
    <details class="dropdown lg:hidden">
      <summary class="btn btn-ghost" aria-label="Open menu">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </summary>
      <ul class="menu dropdown-content bg-base-100 rounded-box z-50 mt-3 w-56 p-2 shadow">
        {site.nav.map((item) => <li><a href={item.href} class="min-h-11 flex items-center">{item.label}</a></li>)}
      </ul>
    </details>
    <a href="#top" class="px-2 flex items-center">
        <Image src={navMonogram} alt={site.business.name} width={70} height={40} densities={[2]} quality={86} class="h-8 w-auto sm:hidden" />
        <Image src={navLogo} alt={site.business.name} width={260} height={43} densities={[2]} quality={86} class="hidden sm:block h-9 w-auto" />
      </a>
  </div>
  <nav class="navbar-center hidden lg:flex">
    <ul class="menu menu-horizontal px-1">
      {site.nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
    </ul>
  </nav>
  <div class="navbar-end">
    <a href="#book" class="btn btn-accent btn-sm sm:btn-md">Free First Lesson</a>
  </div>
</header>

<script>
  // Close the mobile dropdown after an in-page nav link is tapped so it
  // doesn't stay open covering content once the page scrolls to the anchor.
  document.querySelectorAll('.dropdown a[href^="#"]').forEach((link) => {
    link.addEventListener("click", () => link.closest("details")?.removeAttribute("open"));
  });
</script>
