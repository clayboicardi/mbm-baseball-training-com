---
interface AddOn { label: string; price: number; blurb?: string; }
interface Props {
  name: string;
  price: number;
  currency: string;
  priceLabel?: string;
  priceNote?: string;
  duration?: string;
  features: string[];
  addOns?: AddOn[];
  featured?: boolean;
  cta: { label: string; target: string };
  detailHref?: string;
}
const { name, price, currency, priceLabel, priceNote, duration, features, addOns = [], featured, cta, detailHref } = Astro.props;
const money = new Intl.NumberFormat("en-US", { style: "currency", currency, maximumFractionDigits: 0 });
const displayPrice = priceLabel ?? (price === 0 ? "Free" : money.format(price));
---
<div class={`card border-2 bg-base-100 h-full ${featured ? "border-accent shadow-xl" : "border-base-300"}`}>
  <div class="card-body flex flex-col">
    {featured && <span class="badge border-0 bg-brand-red-dark text-white self-start">Best Value</span>}
    <h3 class="card-title font-heading text-2xl">{name}</h3>
    {duration && <p class="text-sm text-base-content/70">{duration}</p>}
    <p class="mt-2"><span class="text-3xl font-bold text-primary break-words">{displayPrice}</span></p>
    {priceNote && <p class="text-sm text-base-content/70">{priceNote}</p>}
    <ul class="mt-4 space-y-2 text-sm">
      {features.map((f) => <li class="flex gap-2"><span aria-hidden="true" class="text-accent font-bold">✓</span><span>{f}</span></li>)}
    </ul>
    {addOns.length > 0 && (
      <ul class="mt-3 space-y-1 border-t border-base-300 pt-3">
        {addOns.map((a) => <li class="text-xs text-base-content/70">+ {a.label} — {money.format(a.price)}</li>)}
      </ul>
    )}
    <div class="card-actions mt-auto pt-6 flex-col gap-2">
      <a href={cta.target} class={`btn w-full ${featured ? "btn-accent" : "btn-primary"}`}>{cta.label}</a>
      {detailHref && <a href={detailHref} class="link link-hover text-sm text-primary font-semibold">See full details →</a>}
    </div>
  </div>
</div>
