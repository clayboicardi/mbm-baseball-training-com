---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Services from "../components/Services.astro";
import Programs from "../components/Programs.astro";
import Packages from "../components/Packages.astro";
import Booking from "../components/Booking.astro";
import Proof from "../components/Proof.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import Pitching from "../components/Pitching.astro";
import Quotes from "../components/Quotes.astro";
import Faq from "../components/Faq.astro";
import Reveal from "../components/ui/Reveal.astro";
import PhotoDivider from "../components/ui/PhotoDivider.astro";
import dividerCleats from "../assets/photos/detail-cleats.jpg";
import dividerBats from "../assets/photos/detail-bats.jpg";
import { SITE, ID } from "../data/schema-global";
import { webPageNode } from "../data/schema";

const title = "Private Baseball Lessons in Long Beach & Orange County | MBM";
const description =
  "Private youth baseball lessons in Long Beach & Orange County. Hitting, fielding, throwing & baseball IQ with Coach Myles, ages 8–18. Claim a free first lesson.";

// Home WebPage is "about" the business; the global LocalBusiness/WebSite/Person
// nodes are emitted by StructuredData on every page.
const pageSchema = webPageNode({
  url: `${SITE}/`,
  name: title,
  description,
  about: ID.localBusiness,
});
---
<BaseLayout title={title} description={description} pageSchema={pageSchema}>
  <Nav />
  <main id="main">
    <Hero />
    <About />
    <Reveal><Services /></Reveal>
    <Reveal><Programs /></Reveal>
    <Pitching />
    <Quotes />
    <PhotoDivider src={dividerCleats} widths={[640, 960, 1264, 1920]} alt="Close-up of youth baseball cleats digging into the infield dirt during a training session" />
    <Reveal><Packages /></Reveal>
    <Booking />
    <PhotoDivider src={dividerBats} alt="A row of youth baseball bats lined up on the dugout bench before practice" />
    <Proof />
    <Faq />
    <Contact />
  </main>
  <Footer />
</BaseLayout>
