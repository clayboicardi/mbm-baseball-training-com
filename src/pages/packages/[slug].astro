---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import packagesData from "../../data/packages.json";
import { abs, serviceNode, offerNode, webPageNode, breadcrumbNode, serviceIdFor, breadcrumbIdFor } from "../../data/schema";
import Breadcrumb from "../../components/ui/Breadcrumb.astro";
import Ornament from "../../components/ui/Ornament.astro";
import Reveal from "../../components/ui/Reveal.astro";
import SectionHeading from "../../components/ui/SectionHeading.astro";

interface AddOn { label: string; price: number; blurb?: string; }
interface Tier {
  id: string; name: string; price: number; priceLabel?: string; priceNote?: string;
  duration: string; features: string[]; addOns?: string[];
  featured?: boolean; cta: { label: string; target: string };
}

export async function getStaticPaths() {
  const pages = (await getCollection("packagePages")).sort((a, b) => a.data.order - b.data.order);
  return pages.map((entry) => ({ params: { slug: entry.id }, props: { entry, pages } }));
}

const { entry, pages } = Astro.props;
const d = entry.data;
const url = abs(`/packages/${entry.id}/`);

// Join locked pricing data by tier id. The page is the single editorial layer;
// price/duration/features/add-ons remain sourced from packages.json.
const catalog = (packagesData.addOnsCatalog ?? {}) as Record<string, AddOn>;
const tier = (packagesData.tiers as Tier[]).find((t) => t.id === d.tier);
if (!tier) throw new Error(`package-pages/${entry.id}: no packages.json tier with id "${d.tier}"`);
const money = new Intl.NumberFormat("en-US", { style: "currency", currency: packagesData.currency, maximumFractionDigits: 0 });
const displayPrice = tier.priceLabel ?? (tier.price === 0 ? "Free" : money.format(tier.price));
const addOns = (tier.addOns ?? []).map((k) => catalog[k]).filter(Boolean);
// Rooted anchor so the tier's homepage CTA target works from this subpage.
const ctaHref = `/${tier.cta.target.replace(/^\/?#/, "#")}`;
const others = pages.filter((p) => p.id !== entry.id);

const pageSchema = [
  serviceNode({
    url,
    name: tier.name,
    serviceType: d.serviceType,
    description: d.description,
    offers: offerNode({ url, price: tier.price, priceCurrency: packagesData.currency }),
  }),
  webPageNode({
    url,
    name: d.title,
    description: d.description,
    about: serviceIdFor(url),
    breadcrumb: breadcrumbIdFor(url),
  }),
  breadcrumbNode(url, [
    { name: "Home", item: abs("/") },
    { name: "Packages", item: abs("/packages/") },
    { name: tier.name, item: url },
  ]),
];
---
<BaseLayout title={d.title} description={d.description} pageSchema={pageSchema}>
  <Nav />
  <main id="main">
    <section class="bg-neutral text-neutral-content py-16 px-4">
      <div class="max-w-4xl mx-auto">
        <Breadcrumb items={[{label:"Home",href:"/"}, {label:"Packages", href:"/packages/"}, {label:tier.name}]} tone="dark" />
        <p class="mt-4 font-heading text-sm uppercase tracking-[0.25em] text-marigold">Training Package</p>
        <h1 class="font-display fluid-lg uppercase text-white mt-2">{d.h1}</h1>
        <div class="mt-4 w-28"><Ornament variant="stitch" /></div>
        <div class="mt-4 flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <span class="text-3xl font-bold text-accent">{displayPrice}</span>
          <span class="text-neutral-content/70">{tier.duration}</span>
          {tier.priceNote && <span class="text-sm text-neutral-content/60">· {tier.priceNote}</span>}
        </div>
        <p class="mt-4 text-lg text-neutral-content/85 max-w-2xl">{d.lead}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={ctaHref} class="btn btn-accent btn-lg">{tier.cta.label}</a>
          <a href="/packages/" class="btn btn-lg btn-outline text-white border-white hover:bg-white hover:text-primary">Compare all packages</a>
        </div>
      </div>
    </section>

    <section class="py-16 px-4 bg-base-100">
      <div class="max-w-3xl mx-auto prose prose-headings:font-heading prose-headings:text-primary prose-a:text-primary">
        {d.body.map((p) => <p>{p}</p>)}
      </div>
    </section>

    <section class="py-16 px-4 bg-paper">
      <div class="max-w-3xl mx-auto">
        <SectionHeading eyebrow="The Package" title="What's included" align="left" />
        <Reveal>
          <ul class="mt-6 space-y-2">
            {tier.features.map((f) => (
              <li class="flex gap-2"><span aria-hidden="true" class="text-accent font-bold">✓</span><span class="text-base-content/80">{f}</span></li>
            ))}
          </ul>
          {addOns.length > 0 && (
            <div class="mt-8 border-t border-base-300 pt-6">
              <h3 class="font-heading font-bold text-primary uppercase tracking-wide text-sm">Optional add-ons</h3>
              <ul class="mt-3 space-y-1">
                {addOns.map((a) => (
                  <li class="text-sm text-base-content/70">+ {a.label} — {money.format(a.price)}{a.blurb && <span class="text-base-content/50"> · {a.blurb}</span>}</li>
                ))}
              </ul>
            </div>
          )}
        </Reveal>
      </div>
    </section>

    <section class="py-16 px-4 bg-base-100">
      <div class="max-w-3xl mx-auto">
        <SectionHeading eyebrow="Best Fit" title="Who it's for" align="left" />
        <Reveal>
          <ul class="mt-6 grid sm:grid-cols-2 gap-3">
            {d.bestFor.map((b) => (
              <li class="card bg-paper p-4 text-base-content/80">{b}</li>
            ))}
          </ul>
        </Reveal>
      </div>
    </section>

    {d.faq.length > 0 && (
      <section class="py-16 px-4 bg-paper">
        <div class="max-w-3xl mx-auto">
          <SectionHeading eyebrow="Common Questions" title={`${tier.name} — Common Questions`} align="center" />
          <Reveal>
            <div class="mt-8 space-y-3">
              {d.faq.map((f) => (
                <details class="collapse collapse-arrow bg-base-200" name="package-faq">
                  <summary class="collapse-title text-lg font-semibold">{f.q}</summary>
                  <div class="collapse-content"><p class="text-base-content/80">{f.a}</p></div>
                </details>
              ))}
            </div>
            <div class="text-center mt-10">
              <a href={ctaHref} class="btn btn-accent btn-lg">{tier.cta.label}</a>
            </div>
          </Reveal>
        </div>
      </section>
    )}

    {others.length > 0 && (
      <section class="py-16 px-4 bg-base-100">
        <div class="max-w-4xl mx-auto text-center">
          <SectionHeading eyebrow="Keep Exploring" title="Other packages" align="center" />
          <Reveal>
            <div class="mt-6 flex flex-wrap gap-3 justify-center">
              {others.map((o) => (
                <a href={`/packages/${o.id}/`} class="btn btn-outline btn-primary">{o.data.h1}</a>
              ))}
            </div>
          </Reveal>
        </div>
      </section>
    )}
  </main>
  <Footer />
</BaseLayout>