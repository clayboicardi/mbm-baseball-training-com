---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Breadcrumb from "../../components/ui/Breadcrumb.astro";
import Ornament from "../../components/ui/Ornament.astro";
import Reveal from "../../components/ui/Reveal.astro";
import packagesData from "../../data/packages.json";
import { abs, collectionPageNode, breadcrumbNode, webPageIdFor, breadcrumbIdFor } from "../../data/schema";

interface Tier {
  id: string; name: string; price: number; priceLabel?: string; priceNote?: string;
  duration: string; featured?: boolean;
}

const pages = (await getCollection("packagePages")).sort((a, b) => a.data.order - b.data.order);
const tierById = new Map((packagesData.tiers as Tier[]).map((t) => [t.id, t]));
const money = new Intl.NumberFormat("en-US", { style: "currency", currency: packagesData.currency, maximumFractionDigits: 0 });
const url = abs("/packages/");
const title = "Baseball Training Packages & Pricing in Long Beach & OC | MBM";
const description =
  "Compare MBM's private baseball training packages — from a free first lesson and single sessions to the 10-session package and the Elite Season Program. Long Beach & Orange County.";

const pageSchema = [
  collectionPageNode({
    url,
    name: "Training Packages",
    description,
    hasPart: pages.map((p) => webPageIdFor(abs(`/packages/${p.id}/`))),
    breadcrumb: breadcrumbIdFor(url),
  }),
  breadcrumbNode(url, [
    { name: "Home", item: abs("/") },
    { name: "Packages", item: url },
  ]),
];
---
<BaseLayout title={title} description={description} pageSchema={pageSchema}>
  <Nav />
  <main id="main">
    <section class="bg-neutral text-neutral-content py-16 px-4">
      <div class="max-w-4xl mx-auto">
        <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Packages" }]} tone="dark" />
        <p class="mt-4 font-heading text-sm uppercase tracking-[0.25em] text-marigold">Pricing</p>
        <h1 class="font-display fluid-lg uppercase text-white mt-2">Training Packages</h1>
        <div class="mt-4 w-28"><Ornament variant="stitch" /></div>
        <p class="mt-4 text-lg text-neutral-content/85 max-w-2xl">{description}</p>
      </div>
    </section>

    <section class="bg-paper py-16 px-4">
      <div class="max-w-4xl mx-auto">
        <Reveal>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {pages.map((p) => {
              const t = tierById.get(p.data.tier);
              const price = t && (t.priceLabel ?? (t.price === 0 ? "Free" : money.format(t.price)));
              return (
                <a href={`/packages/${p.id}/`} class={`group relative block overflow-hidden rounded-box border bg-base-100 p-6 transition-all hover:-translate-y-1 hover:shadow-lg ${t?.featured ? "border-accent hover:border-marigold/60" : "border-base-300 hover:border-marigold/60"}`}>
                  <span aria-hidden="true" class="absolute right-4 top-4 text-marigold"><Ornament variant="diamond" class="w-3.5 h-3.5" /></span>
                  {t?.featured && <span class="badge border-0 bg-brand-red-dark text-white self-start mb-2">Best Value</span>}
                  <h2 class="text-xl font-heading font-bold text-primary uppercase">{p.data.h1}</h2>
                  {t && (
                    <p class="mt-1 text-sm text-base-content/70">
                      <span class="font-bold text-accent">{price}</span> · {t.duration}
                    </p>
                  )}
                  <p class="mt-2 text-sm text-base-content/70">{p.data.lead}</p>
                  <span class="mt-3 inline-block text-sm font-semibold text-primary opacity-80 transition-opacity group-hover:opacity-100">See details →</span>
                </a>
              );
            })}
          </div>
        </Reveal>
        <div class="text-center mt-10">
          <a href="/#book" class="btn btn-accent btn-lg">Claim Your Free First Lesson</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
