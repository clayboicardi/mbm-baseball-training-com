---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { abs, collectionPageNode, breadcrumbNode, webPageIdFor, breadcrumbIdFor } from "../../data/schema";

const cities = (await getCollection("locations")).sort(
  (a, b) => a.data.order - b.data.order || a.data.city.localeCompare(b.data.city, "en"),
);
const url = abs("/baseball-lessons/");
const title = "Baseball Lessons in Long Beach & Orange County — Areas We Serve | MBM";
const description =
  "Private youth baseball lessons across Long Beach and Orange County. See the areas Coach Myles travels to and book a free first lesson.";

const pageSchema = [
  collectionPageNode({
    url,
    name: "Areas We Serve",
    description,
    hasPart: cities.map((c) => webPageIdFor(abs(`/baseball-lessons/${c.id}/`))),
    breadcrumb: breadcrumbIdFor(url),
  }),
  breadcrumbNode(url, [
    { name: "Home", item: abs("/") },
    { name: "Areas We Serve", item: url },
  ]),
];
---
<BaseLayout title={title} description={description} pageSchema={pageSchema}>
  <Nav />
  <main id="main">
    <section class="bg-neutral text-neutral-content py-16 px-4">
      <div class="max-w-4xl mx-auto">
        <nav aria-label="Breadcrumb" class="text-sm text-neutral-content/60">
          <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
            <li><a href="/" class="link link-hover">Home</a></li>
            <li aria-hidden="true">/</li>
            <li><span class="text-neutral-content/90" aria-current="page">Areas We Serve</span></li>
          </ol>
        </nav>
        <h1 class="mt-4 text-4xl sm:text-5xl font-heading font-bold uppercase">Areas We Serve</h1>
        <p class="mt-4 text-lg text-neutral-content/85 max-w-2xl">{description}</p>
      </div>
    </section>

    <section class="py-16 px-4">
      <div class="max-w-4xl mx-auto">
        {cities.length === 0 ? (
          <p class="text-center text-base-content/60">City pages coming soon.</p>
        ) : (
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {cities.map((c) => (
              <a href={`/baseball-lessons/${c.id}/`} class="card bg-base-200 p-6 hover:bg-base-300 transition-colors">
                <h2 class="text-xl font-heading font-bold text-primary uppercase">{c.data.city}</h2>
                <p class="mt-2 text-sm text-base-content/70">{c.data.region}</p>
              </a>
            ))}
          </div>
        )}
        <div class="text-center mt-10">
          <a href="/#book" class="btn btn-accent btn-lg">Claim Your Free First Lesson</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
