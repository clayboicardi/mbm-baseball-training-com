---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { abs, serviceNode, webPageNode, breadcrumbNode, serviceIdFor, breadcrumbIdFor } from "../../data/schema";
import { relatedLocations } from "../../lib/related-locations.mjs";
import Breadcrumb from "../../components/ui/Breadcrumb.astro";
import Ornament from "../../components/ui/Ornament.astro";
import Reveal from "../../components/ui/Reveal.astro";
import SectionHeading from "../../components/ui/SectionHeading.astro";
import { Image } from "astro:assets";
import fieldLongbeach from "../../assets/photos/field-longbeach.jpg";
import fieldCages from "../../assets/photos/field-cages.jpg";

// One shared, people-free golden-hour field photo behind every city hero —
// honest (a quiet local diamond, no stadium/crowd), so the alt is generic.
const heroAlt = "A quiet local baseball field at golden hour with palm trees beyond the outfield";
const ctaAlt = "Empty batting cages at dusk under the lights";

export async function getStaticPaths() {
  const all = (await getCollection("locations")).sort((a, b) => a.data.order - b.data.order);
  return all.map((entry) => ({ params: { city: entry.id }, props: { entry, all } }));
}

const { entry, all } = Astro.props;
const d = entry.data;
const url = abs(`/baseball-lessons/${entry.id}/`);
const related = relatedLocations(all, entry.id, 3);

// Per-route nodes: Service (the local offering) + WebPage (about the Service) +
// BreadcrumbList. The global LocalBusiness/WebSite/Person come from StructuredData.
const pageSchema = [
  serviceNode({
    url,
    name: `Private Baseball Lessons in ${d.city}`,
    serviceType: "Youth baseball training",
    description: d.description,
    areaServed: { "@type": "City", name: d.city },
  }),
  webPageNode({
    url,
    name: d.title,
    description: d.description,
    about: serviceIdFor(url),
    breadcrumb: breadcrumbIdFor(url),
  }),
  breadcrumbNode(url, [
    { name: "Home", item: abs("/") },
    { name: "Areas We Serve", item: abs("/baseball-lessons/") },
    { name: d.city, item: url },
  ]),
];
---
<BaseLayout title={d.title} description={d.description} pageSchema={pageSchema}>
  <Nav />
  <main id="main">
    <section class="relative overflow-hidden bg-neutral text-neutral-content py-16 px-4">
      <Image src={fieldLongbeach} alt={heroAlt} widths={[640, 960, 1264, 1920]} sizes="100vw" format="webp" loading="eager" fetchpriority="high" quality={64} class="absolute inset-0 h-full w-full object-cover object-center" />
      <div class="absolute inset-0 bg-gradient-to-r from-neutral/80 via-neutral/50 to-neutral/22"></div>
      <div class="relative z-10 max-w-4xl mx-auto">
        <Breadcrumb items={[{label:"Home",href:"/"}, {label:"Areas We Serve", href:"/baseball-lessons/"}, {label:d.city}]} tone="dark" />
        <p class="mt-4 font-heading text-sm uppercase tracking-[0.25em] text-marigold [text-shadow:0_2px_12px_#0b1f338c]">Baseball Lessons</p>
        <h1 class="font-display fluid-lg uppercase text-white mt-2 [text-shadow:0_2px_16px_#0b1f33a6]">{d.h1}</h1>
        <div class="mt-4 w-28"><Ornament variant="stitch" /></div>
        <p class="mt-4 text-lg text-neutral-content/85 max-w-2xl [text-shadow:0_2px_12px_#0b1f338c]">{d.lead}</p>
        {d.travel && <p class="mt-3 text-sm text-neutral-content/70 [text-shadow:0_2px_12px_#0b1f338c]">{d.travel}</p>}
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/#book" class="btn btn-accent btn-lg">Claim Your Free First Lesson</a>
          <a href="/#packages" class="btn btn-lg btn-outline text-white border-white hover:bg-white hover:text-primary">View Packages</a>
        </div>
      </div>
    </section>

    <section class="py-16 px-4 bg-base-100">
      <div class="max-w-3xl mx-auto prose prose-headings:font-heading prose-headings:text-primary prose-a:text-primary">
        {d.body.map((p) => <p>{p}</p>)}
      </div>
    </section>

    {(d.fields.length > 0 || d.scene) && (
      <section class="py-16 px-4 bg-paper">
        <div class="max-w-3xl mx-auto">
          <SectionHeading eyebrow="Local Baseball" title={`Baseball in ${d.city}`} align="left" />
          <Reveal>
            {d.scene && <p class="mt-4 text-base-content/80">{d.scene}</p>}
            {d.fields.length > 0 && (
              <ul class="mt-6 grid sm:grid-cols-2 gap-3">
                {d.fields.map((f) => (
                  <li class="card bg-base-100 p-4">
                    <p class="font-semibold text-primary">{f.name}</p>
                    {f.note && <p class="text-sm text-base-content/70 mt-1">{f.note}</p>}
                  </li>
                ))}
              </ul>
            )}
            <p class="mt-6 text-sm text-base-content/60">Coach Myles travels to you — we'll meet at a field that works for your family.</p>
          </Reveal>
        </div>
      </section>
    )}

    <section class="relative overflow-hidden bg-neutral text-neutral-content py-16 px-4">
      <Image src={fieldCages} alt={ctaAlt} widths={[640, 960, 1376]} sizes="100vw" format="webp" loading="lazy" quality={62} class="absolute inset-0 h-full w-full object-cover object-center" />
      <div class="absolute inset-0 bg-gradient-to-b from-neutral/75 via-neutral/85 to-neutral/75"></div>
      <div class="relative z-10 max-w-3xl mx-auto text-center">
        <p class="font-heading text-sm uppercase tracking-[0.2em] text-accent [text-shadow:0_2px_12px_#0b1f338c]">The Work</p>
        <h2 class="font-display fluid-lg uppercase text-white mt-1 [text-shadow:0_2px_16px_#0b1f33a6]">What we work on</h2>
        <div class="mt-3 w-24 mx-auto"><Ornament variant="stitch" /></div>
        <Reveal>
          <p class="mt-4 text-neutral-content/90 [text-shadow:0_2px_12px_#0b1f338c]">Hitting, fielding, throwing, pitching, baseball IQ, and the mental game — every session is built around your player.</p>
          <a href="/coaching/" class="btn btn-lg btn-outline text-white border-white hover:bg-white hover:text-primary mt-6">See all coaching</a>
        </Reveal>
      </div>
    </section>

    {d.faq.length > 0 && (
      <section class="py-16 px-4 bg-paper">
        <div class="max-w-3xl mx-auto">
          <SectionHeading eyebrow="Common Questions" title={`${d.city} — Common Questions`} align="center" />
          <Reveal>
            <div class="mt-8 space-y-3">
              {d.faq.map((f) => (
                <details class="collapse collapse-arrow bg-base-200" name="city-faq">
                  <summary class="collapse-title text-lg font-semibold">{f.q}</summary>
                  <div class="collapse-content"><p class="text-base-content/80">{f.a}</p></div>
                </details>
              ))}
            </div>
          </Reveal>
        </div>
      </section>
    )}

    {related.length > 0 && (
      <section class="py-16 px-4 bg-base-100">
        <div class="max-w-4xl mx-auto text-center">
          <SectionHeading eyebrow="Keep Exploring" title="Also serving nearby" align="center" />
          <Reveal>
            <div class="mt-6 flex flex-wrap gap-3 justify-center">
              {related.map((r) => (
                <a href={`/baseball-lessons/${r.id}/`} class="btn btn-outline btn-primary">{r.data.city}</a>
              ))}
            </div>
          </Reveal>
        </div>
      </section>
    )}
  </main>
  <Footer />
</BaseLayout>