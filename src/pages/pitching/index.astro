---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Breadcrumb from "../../components/ui/Breadcrumb.astro";
import Ornament from "../../components/ui/Ornament.astro";
import Reveal from "../../components/ui/Reveal.astro";
import { Image } from "astro:assets";
import heroImg from "../../assets/photos/pitching-mound.jpg";
import { abs, collectionPageNode, breadcrumbNode, breadcrumbIdFor } from "../../data/schema";
import pitchingData from "../../data/pitching.json";
const { intro, method } = pitchingData as { intro: string; method: { title: string; blurb: string }[] };

const posts = (await getCollection("pitches"))
  .filter((p) => import.meta.env.DEV || !p.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
const url = abs("/pitching/");
const title = "Pitching Development Guides | MBM Baseball Training";
const description =
  "How Coach Myles develops young pitchers — proper mechanics, healthy development, and mound mindset, pitch by pitch. Private lessons in Long Beach & Orange County.";

const pageSchema = [
  collectionPageNode({
    url,
    name: "Pitching Development Guides",
    description,
    hasPart: posts.map((p) => `${abs(`/pitching/${p.id}/`)}#article`),
    breadcrumb: breadcrumbIdFor(url),
  }),
  breadcrumbNode(url, [
    { name: "Home", item: abs("/") },
    { name: "Pitching", item: url },
  ]),
];
---
<BaseLayout title={title} description={description} pageSchema={pageSchema}>
  <Nav />
  <main id="main">
    <section class="relative overflow-hidden bg-neutral text-neutral-content py-16 px-4">
      <Image src={heroImg} alt="Coach Myles coaching a young pitcher on the mound at golden hour" widths={[640, 960, 1264]} sizes="100vw" format="webp" loading="eager" fetchpriority="high" quality={64} class="absolute inset-0 h-full w-full object-cover object-center" />
      <div class="absolute inset-0 bg-gradient-to-r from-neutral/80 via-neutral/50 to-neutral/22"></div>
      <div class="relative z-10 max-w-4xl mx-auto">
        <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Pitching" }]} tone="dark" />
        <p class="mt-4 font-heading text-sm uppercase tracking-[0.25em] text-marigold [text-shadow:0_2px_12px_#0b1f338c]">Pitching Development</p>
        <h1 class="font-display fluid-lg uppercase text-white mt-2 [text-shadow:0_2px_16px_#0b1f33a6]">Pitching Development Guides</h1>
        <div class="mt-4 w-28"><Ornament variant="stitch" /></div>
        <p class="mt-4 text-lg text-neutral-content/85 max-w-2xl [text-shadow:0_2px_12px_#0b1f338c]">{description}</p>
      </div>
    </section>
    <section class="py-16 px-4 bg-base-100">
      <div class="max-w-3xl mx-auto">
        <p class="text-lg text-base-content/80">{intro}</p>
      </div>
    </section>
    <section class="bg-paper py-16 px-4">
      <div class="max-w-4xl mx-auto">
        {posts.length === 0 ? (
          <p class="text-center text-base-content/60">Guides coming soon.</p>
        ) : (
          <Reveal>
            <div class="grid sm:grid-cols-2 gap-4">
              {posts.map((p, i) => (
                <a href={`/pitching/${p.id}/`} class="group relative block overflow-hidden rounded-box border border-base-300 bg-base-100 p-6 transition-all hover:-translate-y-1 hover:border-marigold/60 hover:shadow-lg">
                  <span aria-hidden="true" class="absolute right-4 top-4 text-marigold"><Ornament variant="diamond" class="w-3.5 h-3.5" /></span>
                  <span aria-hidden="true" class="font-display text-base-content/15 text-3xl leading-none">{String(i + 1).padStart(2, "0")}</span>
                  <h2 class="mt-2 text-xl font-heading font-bold text-primary uppercase">{p.data.pitch}</h2>
                  <p class="mt-2 text-sm text-base-content/70">{p.data.description}</p>
                  <span class="mt-3 inline-block text-sm font-semibold text-primary opacity-80 transition-opacity group-hover:opacity-100">Learn more →</span>
                </a>
              ))}
            </div>
          </Reveal>
        )}
        <div class="text-center mt-10">
          <a href="/#book" class="btn btn-accent btn-lg">Claim Your Free First Lesson</a>
        </div>
      </div>
    </section>
    <section class="py-16 px-4 bg-base-100">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-xl font-heading font-bold uppercase tracking-wide text-base-content/80 text-center">The Method</h2>
        <div class="mt-6 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
          {method.map((m) => (
            <div>
              <h3 class="font-heading font-bold text-primary">{m.title}</h3>
              <p class="mt-1 text-sm text-base-content/70">{m.blurb}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
