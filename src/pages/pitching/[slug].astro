---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";

// Spec 1 renderer (docs/content/myles-content-roadmap.md). One page per published
// pitch at /pitching/<slug>. Drafts are excluded, so a pitch goes live only when
// its frontmatter sets draft:false (after Myles confirms the cue). With every stub
// draft:true today, this builds ZERO routes — infra is staged, nothing is live.
export async function getStaticPaths() {
  const posts = (await getCollection("pitches"))
    // DEV-only: preview drafts under `astro dev`. Production `astro build` sets
    // import.meta.env.DEV=false, so drafts stay excluded from live routes.
    .filter((p) => import.meta.env.DEV || !p.data.draft)
    .sort((a, b) => a.data.order - b.data.order);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pitch, cue } = post.data;

// noBusinessSchema: the LocalBusiness entity lives once on the homepage (its @id
// is /#localbusiness). Article pages opt out to avoid duplicating that entity
// across URLs. (Future: add Article/HowTo schema here.)
---
<BaseLayout title={`${pitch} — Pitching Development | MBM`} description={description} noBusinessSchema>
  <Nav />
  <main id="main" class="py-16 px-4">
    <article class="prose max-w-3xl mx-auto prose-headings:font-heading prose-headings:text-primary prose-a:text-primary">
      <p class="text-sm font-heading uppercase tracking-wide text-[#D72B31]">Pitching Development</p>
      <h1>{title}</h1>
      <p class="text-lg italic text-base-content/70">“{cue}” — Coach Myles</p>
      <Content />
      <p class="not-prose mt-10">
        <a href="/#book" class="btn btn-accent">Claim Your Free First Lesson</a>
      </p>
    </article>
  </main>
  <Footer />
</BaseLayout>
