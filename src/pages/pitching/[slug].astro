---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Breadcrumb from "../../components/ui/Breadcrumb.astro";
import Ornament from "../../components/ui/Ornament.astro";
import Reveal from "../../components/ui/Reveal.astro";
import { Image } from "astro:assets";
import gripImg from "../../assets/photos/pitching-grip.jpg";
import { SITE } from "../../data/schema-global";
import { abs, articleNode, webPageNode, breadcrumbNode, breadcrumbIdFor } from "../../data/schema";

// One page per published pitch at /pitching/<slug>. Drafts are excluded in prod
// (import.meta.env.DEV previews them under `astro dev`), so a pitch goes live
// only once its frontmatter sets draft:false.
export async function getStaticPaths() {
  const posts = (await getCollection("pitches"))
    .filter((p) => import.meta.env.DEV || !p.data.draft)
    .sort((a, b) => a.data.order - b.data.order);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pitch } = post.data;

const url = abs(`/pitching/${post.id}/`);
const iso = post.data.updated ? post.data.updated.toISOString() : undefined;
// Per-route nodes: Article (the post) + WebPage (about the Article) +
// BreadcrumbList. Global LocalBusiness/WebSite/Person come from StructuredData.
const pageSchema = [
  articleNode({ url, headline: title, description, image: `${SITE}/mbm-og.png`, datePublished: iso, dateModified: iso }),
  webPageNode({ url, name: title, description, about: `${url}#article`, breadcrumb: breadcrumbIdFor(url) }),
  breadcrumbNode(url, [
    { name: "Home", item: abs("/") },
    { name: "Pitching", item: abs("/pitching/") },
    { name: pitch, item: url },
  ]),
];
---
<BaseLayout title={`${pitch} — Pitching Development | MBM`} description={description} pageSchema={pageSchema}>
  <Nav />
  <main id="main" class="py-16 px-4">
    <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Pitching", href: "/pitching/" }, { label: pitch }]} class="max-w-3xl mx-auto" />
    <header class="max-w-3xl mx-auto mt-4 grid gap-5 sm:grid-cols-[1fr_auto] sm:items-center">
      <div>
        <p class="font-heading text-sm uppercase tracking-[0.2em] text-brand-red-dark">Pitching Development</p>
        <h1 class="font-display fluid-lg uppercase text-primary mt-1">{title}</h1>
        <div class="mt-3 w-24"><Ornament variant="stitch" /></div>
      </div>
      <Image src={gripImg} alt="Close-up of Coach Myles demonstrating a baseball grip" width={200} height={200} densities={[2]} loading="eager" quality={80} class="rounded-box shadow-md w-32 h-32 sm:w-36 sm:h-36 object-cover" />
    </header>
    <Reveal>
      <article class="prose max-w-3xl mx-auto mt-8 prose-headings:font-heading prose-headings:text-primary prose-a:text-primary">
        <Content />
        <p class="not-prose mt-10">
          <a href="/#book" class="btn btn-accent">Claim Your Free First Lesson</a>
        </p>
      </article>
    </Reveal>
    <p class="max-w-3xl mx-auto mt-8 text-sm text-base-content/60">
      ← Back to <a href="/pitching/" class="link link-primary">all pitching guides</a>
    </p>
  </main>
  <Footer />
</BaseLayout>
