---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Breadcrumb from "../components/ui/Breadcrumb.astro";
import Ornament from "../components/ui/Ornament.astro";
import site from "../data/site.json";
import { abs, webPageNode, breadcrumbNode, breadcrumbIdFor } from "../data/schema";
import { ID } from "../data/schema-global";

const url = abs("/contact/");
const title = "Contact Coach Myles | MBM Baseball Training";
const description =
  "Get in touch with Coach Myles at MBM Baseball Training — call, text, email, or send a message. Private youth baseball lessons in Long Beach & Orange County, ages 8–18.";

const pageSchema = [
  webPageNode({
    url,
    name: "Contact MBM Baseball Training",
    description,
    about: ID.localBusiness,
    breadcrumb: breadcrumbIdFor(url),
  }),
  breadcrumbNode(url, [
    { name: "Home", item: abs("/") },
    { name: "Contact", item: url },
  ]),
];
---
<BaseLayout title={title} description={description} pageSchema={pageSchema}>
  <Nav />
  <main id="main">
    <section class="bg-neutral text-neutral-content py-16 px-4">
      <div class="max-w-4xl mx-auto">
        <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Contact" }]} tone="dark" />
        <p class="mt-4 font-heading text-sm uppercase tracking-[0.25em] text-marigold">Get in touch</p>
        <h1 class="font-display fluid-lg uppercase text-white mt-2">Contact Coach Myles</h1>
        <div class="mt-4 w-28"><Ornament variant="stitch" /></div>
        <p class="mt-4 text-lg text-neutral-content/85 max-w-2xl">Questions about training, scheduling, or which program fits your player? Reach out any way that's easiest — Coach Myles personally handles every message.</p>
      </div>
    </section>

    <section class="bg-paper py-16 px-4">
      <div class="max-w-5xl mx-auto grid gap-10 lg:grid-cols-5">
        <!-- Contact details -->
        <div class="lg:col-span-2">
          <h2 class="font-heading text-xl uppercase text-primary">Reach Coach Myles</h2>
          <div class="mt-3 w-16"><Ornament variant="stitch" /></div>
          <dl class="mt-6 space-y-5">
            <div>
              <dt class="text-xs uppercase tracking-wide text-base-content/50">Call or text</dt>
              <dd class="mt-0.5"><a class="link link-primary font-semibold" href={site.business.phoneHref}>{site.business.phone}</a></dd>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-wide text-base-content/50">Email</dt>
              <dd class="mt-0.5"><a class="link link-primary font-semibold break-all" href={`mailto:${site.business.email}`}>{site.business.email}</a></dd>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-wide text-base-content/50">Instagram</dt>
              <dd class="mt-0.5"><a class="link link-primary font-semibold" href={site.business.instagram} target="_blank" rel="noopener noreferrer">{site.business.instagramHandle}<span class="sr-only"> (opens in a new tab)</span></a></dd>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-wide text-base-content/50">Where</dt>
              <dd class="mt-0.5 text-base-content/80">{site.business.serviceArea}</dd>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-wide text-base-content/50">Hours</dt>
              <dd class="mt-0.5 text-base-content/80">{site.business.hours}</dd>
            </div>
            {site.business.googleBusiness && (
              <div>
                <dt class="text-xs uppercase tracking-wide text-base-content/50">Google</dt>
                <dd class="mt-0.5"><a class="link link-primary" href={site.business.googleBusiness} target="_blank" rel="noopener noreferrer">Find us on Google<span class="sr-only"> (opens in a new tab)</span> →</a></dd>
              </div>
            )}
          </dl>
          <a href="/#book" class="btn btn-accent mt-8">Book a free first lesson</a>
        </div>

        <!-- Message form -->
        <div class="lg:col-span-3">
          <h2 class="font-heading text-xl uppercase text-primary">Send a message</h2>
          <p class="mt-1 text-sm text-base-content/60">Prefer to write? Fill this out and Coach Myles will get back to you.</p>
          <iframe title="Contact Coach Myles message form" src="https://tally.so/embed/obge5e?hideTitle=1" sandbox="allow-scripts allow-forms allow-same-origin allow-popups" referrerpolicy="strict-origin-when-cross-origin" class="mt-4 w-full rounded-box border border-base-300" style="height:850px" loading="lazy"></iframe>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
