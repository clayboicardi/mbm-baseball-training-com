---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Page Not Found | MBM Baseball Training"
  description="That page can't be found. Head back to MBM Baseball Training for private youth baseball lessons in Long Beach."
  noindex
>
  <main id="main" class="min-h-[70vh] grid place-items-center text-center px-4">
    <div>
      <h1 class="text-6xl font-heading font-bold text-primary">404</h1>
      <p class="mt-4 text-base-content/70">That page is out of the park. Let's get you back.</p>
      <a href="/" class="btn btn-accent mt-6">Back to Home</a>
    </div>
  </main>
</BaseLayout>
