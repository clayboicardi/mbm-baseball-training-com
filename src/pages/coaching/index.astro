---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { abs, collectionPageNode, breadcrumbNode, webPageIdFor, breadcrumbIdFor } from "../../data/schema";

const skills = (await getCollection("coaching")).sort((a, b) => a.data.order - b.data.order);
const url = abs("/coaching/");
const title = "What Coach Myles Teaches — Baseball Coaching | MBM";
const description =
  "Hitting, fielding, throwing mechanics, baseball IQ, and player development — the skills Coach Myles coaches for players ages 8–18 across Long Beach & Orange County.";

const pageSchema = [
  collectionPageNode({
    url,
    name: "What Coach Myles Teaches",
    description,
    hasPart: skills.map((s) => webPageIdFor(abs(`/coaching/${s.id}/`))),
    breadcrumb: breadcrumbIdFor(url),
  }),
  breadcrumbNode(url, [
    { name: "Home", item: abs("/") },
    { name: "Coaching", item: url },
  ]),
];
---
<BaseLayout title={title} description={description} pageSchema={pageSchema}>
  <Nav />
  <main id="main">
    <section class="bg-neutral text-neutral-content py-16 px-4">
      <div class="max-w-4xl mx-auto">
        <nav aria-label="Breadcrumb" class="text-sm text-neutral-content/60">
          <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
            <li><a href="/" class="link link-hover">Home</a></li>
            <li aria-hidden="true">/</li>
            <li><span class="text-neutral-content/90" aria-current="page">Coaching</span></li>
          </ol>
        </nav>
        <h1 class="mt-4 text-4xl sm:text-5xl font-heading font-bold uppercase">What Coach Myles Teaches</h1>
        <p class="mt-4 text-lg text-neutral-content/85 max-w-2xl">{description}</p>
      </div>
    </section>

    <section class="py-16 px-4">
      <div class="max-w-4xl mx-auto">
        {skills.length === 0 ? (
          <p class="text-center text-base-content/60">Coaching guides coming soon.</p>
        ) : (
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {skills.map((s) => (
              <a href={`/coaching/${s.id}/`} class="card bg-base-200 p-6 hover:bg-base-300 transition-colors">
                <Icon name={s.data.icon} class="w-9 h-9 text-accent" aria-hidden="true" />
                <h2 class="mt-2 text-xl font-heading font-bold text-primary uppercase">{s.data.skill}</h2>
                <p class="mt-2 text-sm text-base-content/70">{s.data.lead}</p>
              </a>
            ))}
          </div>
        )}
        <div class="text-center mt-10">
          <a href="/#book" class="btn btn-accent btn-lg">Claim Your Free First Lesson</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
